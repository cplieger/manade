-A MANADE-FWD -d 64:ff9b::/96 -i manade+ -j DROP
-A MANADE-FWD -d 64:ff9b:1::/48 -i manade+ -j DROP
-A MANADE-FWD -d 100::/64 -i manade+ -j DROP
-A MANADE-FWD -d 2001::/32 -i manade+ -j DROP
-A MANADE-FWD -d 2001:db8::/32 -i manade+ -j DROP
-A MANADE-FWD -d 2002::/16 -i manade+ -j DROP
-A MANADE-FWD -d 2a01:e0a:1::/48 -i manade+ -j DROP
-A MANADE-FWD -d 2a01:e0a:1259:2710::/64 -i manade+ -j DROP
-A MANADE-FWD -d 2a01:e0a:1259:2711::/64 -i manade+ -j DROP
-A MANADE-FWD -d fc00::/7 -i manade+ -j DROP
-A MANADE-FWD -d fe80::/10 -i manade+ -j DROP
-A MANADE-FWD -d ff00::/8 -i manade+ -j DROP
-A MANADE-FWD ! -d 2000::/3 -i manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-FWD ! -d 2000::/3 -i manade+ -j DROP
-A MANADE-FWD -o manade+ -m conntrack --ctstate NEW -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-FWD -o manade+ -m conntrack --ctstate NEW -j DROP
-A MANADE-FWD -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-OUT -o lo -j RETURN
-A MANADE-OUT -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A MANADE-OUT -p ipv6-icmp -m icmp6 --icmpv6-type 135 -j RETURN
-A MANADE-OUT -p ipv6-icmp -m icmp6 --icmpv6-type 136 -j RETURN
-A MANADE-OUT -d 2606:4700:4700::1111/128 -p tcp -m tcp --dport 53 -j RETURN
-A MANADE-OUT -d 2606:4700:4700::1111/128 -p udp -m udp --dport 53 -j RETURN
-A MANADE-OUT -d fd00::5/128 -p udp -m udp --dport 53 -j RETURN
-A MANADE-OUT -d ::ffff:0.0.0.0/96 ! -o manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-OUT -d 64:ff9b::/96 ! -o manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-OUT -d 64:ff9b:1::/48 ! -o manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-OUT -d 100::/64 ! -o manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
