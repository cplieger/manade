-A MANADE-FWD -d 2a01:e0a:1::/48 -i manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-FWD -d 2a01:e0a:1259:2710::/64 -i manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
