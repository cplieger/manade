-A MANADE-OUT -d 2a01:e0a:1::/48 ! -o manade+ -j DROP
-A MANADE-OUT -d 2a01:e0a:1259:2710::/64 ! -o manade+ -j DROP
-A MANADE-OUT -d 2a01:e0a:1259:2711::/64 ! -o manade+ -j DROP
-A MANADE-OUT -d fc00::/7 ! -o manade+ -j DROP
-A MANADE-OUT -d fe80::/10 ! -o manade+ -j DROP
-A MANADE-OUT -d ff00::/8 ! -o manade+ -j DROP
-A MANADE-OUT ! -d 2000::/3 ! -o manade+ -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
-A MANADE-OUT ! -d 2000::/3 ! -o manade+ -j DROP
-A MANADE-OUT -m set --match-set manade-probe6 src -m set --match-set manade-target6 dst
